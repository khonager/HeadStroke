{
  "name": "headstroke",
  "version": "0.1.0",
  "description": "Head-movement sketchbook for Even G2",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run test && npm run build && npm run test:e2e",
    "pack": "npm run build && mkdir -p artifacts && evenhub pack app.json dist --sdk-ver 0.0.16 -o artifacts/headstroke-0.1.0.ehpk",
    "qr": "evenhub qr --port 5173 --path /",
    "simulate": "node scripts/simulator.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/khonager/HeadStroke.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/khonager/HeadStroke/issues"
  },
  "homepage": "https://github.com/khonager/HeadStroke#readme",
  "dependencies": {
    "@evenrealities/even_hub_sdk": "0.0.16"
  },
  "devDependencies": {
    "@evenrealities/evenhub-cli": "0.2.0",
    "@evenrealities/evenhub-simulator": "0.9.5",
    "@playwright/test": "1.64.1",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "private": true,
  "type": "module"
}
